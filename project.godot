; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Yggdrasil"
run/main_scene="uid://dui6pduprwsc"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
MusicPlayer="*res://Assets/Escenas/Global/MusicPlayer.tscn"
TestScene="*res://BranchOtro/scripts/test_scene.gd"
ButtonSound="*res://Assets/Escenas/Audios/ButtonSound.tscn"
Globals="*res://Assets/Escenas/Global/Globals.gd"

[dialogue_manager]

runtime/balloon_path="res://Assets/Dialogos/balloon.tscn"

[display]

window/stretch/mode="viewport"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Assets/Escenas/Enemigos/": "red",
"res://Assets/sprites/enemies/": "red",
"res://Multijugador/": "blue"
}

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true
pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://Assets/Dialogos/Dialogo.dialogue", "res://Assets/Dialogos/Mundo1/Intro_Nivel_1-1.dialogue")

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
